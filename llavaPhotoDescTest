from ollama import chat

response = chat(
    model="llava",
    messages=[
        {
            "role": "user",
            "content": "Describe this image in detail.",
            "images": ["./exampleGDELTMoreSteps.png"],
        }
    ],
    stream=True,
)

for chunk in response:
    print(chunk.message.content, end="", flush=True)